rules_version = '2';

// Reguły bezpieczeństwa bazy Firestore dla strony biblioteki.
// Wklej je w: Firebase Console → Firestore Database → Reguły → Opublikuj.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function docPath(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function isLibrarian() {
      return signedIn() && request.auth.token.email != null
        && exists(docPath('librarians', request.auth.token.email.lower()));
    }
    function profile() { return get(docPath('users', request.auth.uid)).data; }

    // Bibliotekarze: dokument o ID = e-mail (małymi literami). Dodawani ręcznie w konsoli.
    match /librarians/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Ustawienia (np. config/registration z polem "code") – niewidoczne dla nikogo ze strony.
    match /config/{id} {
      allow read, write: if false;
    }

    // Profile czytelników
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isLibrarian());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'klasa', 'email', 'code', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && request.resource.data.klasa is string && request.resource.data.klasa.size() <= 12
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time
        && (!exists(docPath('config', 'registration'))
            || request.resource.data.code == get(docPath('config', 'registration')).data.code);
      allow update, delete: if false;
    }

    // Rezerwacje: ID = {uid}_1, {uid}_2 lub {uid}_3 → maksymalnie 3 na osobę.
    match /reservations/{resId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isLibrarian());
      allow create: if signedIn()
        && exists(docPath('users', request.auth.uid))
        && resId.matches(request.auth.uid + '_[123]')
        && request.resource.data.keys().hasOnly(['uid', 'bookId', 'title', 'author', 'userName', 'klasa', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bookId is string && request.resource.data.bookId.size() <= 20
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.author is string && request.resource.data.author.size() <= 120
        && request.resource.data.userName == profile().name
        && request.resource.data.klasa == profile().klasa
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isLibrarian());
      allow update: if false;
    }
  }
}
